{
  "compilerOptions": {
    "jsx": "react",
    "module": "Node16",
    "moduleResolution": "node16",
    "target": "ES2021",
    "lib": ["ES2021"],
    "lib": ["dom"],

    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "removeComments": true,
    "incremental": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "skipLibCheck": true,
    "strict": false,

    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  }
}