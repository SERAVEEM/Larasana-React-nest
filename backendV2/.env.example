# ── Database (shared semua service) ──────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=larasana_db

# ── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=ganti_random_string_panjang_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=ganti_random_string_panjang_refresh
JWT_REFRESH_EXPIRES_IN=7d

# ── Service Ports ─────────────────────────────────────────────
GATEWAY_PORT=3000
USERS_SERVICE_PORT=3001
COMMERCE_SERVICE_PORT=3002
NOTIFICATION_SERVICE_PORT=3003

# ── Mail ──────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM="LARASANA <no-reply@larasana.id>"

# ── Midtrans ──────────────────────────────────────────────────
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxx
MIDTRANS_IS_SANDBOX=true

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── EasyPost Shipping API ─────────────────────────────────────
# Replace with your test or production EasyPost API key
EASYPOST_API_KEY=

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Cloudflare R2 Object Storage ─────────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=larasana
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
