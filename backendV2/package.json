{
  "name": "larasana-microservices",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:gateway": "nest start api-gateway --watch -r tsconfig-paths/register",
    "start:auth": "nest start auth-service --watch -r tsconfig-paths/register",
    "start:users": "nest start users-service --watch -r tsconfig-paths/register",
    "start:orders": "nest start orders-service --watch -r tsconfig-paths/register",
    "start:products": "nest start products-service --watch -r tsconfig-paths/register",
    "start:payments": "nest start payments-service --watch -r tsconfig-paths/register",
    "start:admin": "nest start admin-service --watch -r tsconfig-paths/register",
    "start:notification": "nest start notification-service --watch -r tsconfig-paths/register",
    "start:favorites": "nest start favorites-service --watch -r tsconfig-paths/register",
    "start:addresses": "nest start addresses-service --watch -r tsconfig-paths/register",
    "start:shipping": "nest start shipping-service --watch -r tsconfig-paths/register",

    "build": "nest build"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.0.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "mysql2": "^3.9.7",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.15",
    "@types/passport-jwt": "^4.0.1",
    "typescript": "^5.1.3"
  }
}