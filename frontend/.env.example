# URL base API Gateway
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Client ID dari Google Cloud Console untuk login SSO
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# URL Cloudflare R2 Public Bucket
VITE_R2_ASSETS_URL=https://pub-xxxxx.r2.dev

# Key secret yang cocok dengan FRONTEND_CLIENT_SECRET di backend
VITE_FRONTEND_CLIENT_SECRET=your_api_client_secret_key
